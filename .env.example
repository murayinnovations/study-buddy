# Copy to .env.local for local development, and add the same values in Vercel.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase: Project Settings → API Keys in the Supabase dashboard.
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
# Publishable key (sb_publishable_…), or the legacy "anon" key. Used for sign-in only; data goes through the app's own API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Secret key (sb_secret_…), or the legacy "service_role" key. Server only: bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
