# Copy to .env.local for local development, and add the same values in Vercel.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase: Project Settings → API Keys in the Supabase dashboard.
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
# Publishable key (sb_publishable_…), or the legacy "anon" key. Used for sign-in only; data goes through the app's own API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Secret key (sb_secret_…), or the legacy "service_role" key. Server only: bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Opening Curriculum AI from a learning platform such as Moodle (LTI 1.3, see README).
# The key Curriculum AI signs with: make one with `node scripts/lti-key.mjs`. Server only.
LTI_PRIVATE_KEY=your_lti_private_key_here
# Emails admins when a new platform registers and needs approval (resend.com → API Keys).
RESEND_API_KEY=your_resend_api_key_here
# Optional sender. Without a verified domain in Resend, leave it unset: Resend's test sender
# only delivers to the email you signed up to Resend with, so make that an admin's email.
ALERT_FROM_EMAIL=
